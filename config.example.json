{
  "reviewers": [],
  "reviewContext": {
    "mode": "transcript",
    "conversationTokens": 4000,
    "toolTokens": 2000,
    "persistence": "command"
  },
  "execution": {
    "maxConcurrentSandboxes": 4
  },
  "reactiveReview": {
    "reasoning": "one-lower",
    "floor": "low",
    "inspection": "destination",
    "incompleteBodyApproval": "human",
    "requestIdentityIgnoredHeaders": []
  },
  "boundaryReview": {
    "publicKeyRead": "review",
    "gitFsmonitor": true,
    "gitSshAgent": "review"
  },
  "policy": "Escalate whenever the exact effects or authorization are unclear."
}
