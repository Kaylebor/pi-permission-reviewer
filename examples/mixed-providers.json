{
  "reviewers": [
    {
      "level": 0,
      "model": "ollama-cloud/fast-reviewer",
      "reasoning": "low",
      "timeoutMs": 30000
    },
    {
      "level": 1,
      "model": "openai-codex/gpt-5.6-terra",
      "reasoning": "medium",
      "timeoutMs": 60000
    },
    {
      "level": 2,
      "model": "another-provider/strong-reviewer",
      "reasoning": "high",
      "timeoutMs": 120000
    }
  ],
  "reviewContext": {
    "mode": "transcript",
    "conversationTokens": 4000,
    "toolTokens": 2000,
    "persistence": "command"
  },
  "reactiveReview": {
    "reasoning": "one-lower",
    "floor": "low"
  },
  "boundaryReview": {
    "publicKeyRead": "review",
    "gitFsmonitor": true,
    "gitSshAgent": "review"
  },
  "policy": "Escalate uncertain side effects, authorization, credential access, and external writes."
}
